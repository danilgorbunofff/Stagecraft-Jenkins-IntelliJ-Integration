<idea-plugin>
    <id>dev.stagecraft.jenkins</id>
    <!-- name and description are set from build.gradle.kts (§8.2 listing title and lines). -->
    <name>Stagecraft - Jenkins Build &amp; Log Viewer</name>
    <vendor>Stagecraft</vendor>

    <description><![CDATA[
    <p>A Jenkins build and log viewer for JetBrains IDEs, built around the things that make other
    Jenkins plugins unusable: folder and multibranch job discovery that actually finds your job,
    per-stage logs for declarative pipelines, live console output that keeps up, and network
    failures that say what went wrong instead of freezing the IDE.</p>
    <p>Works against Jenkins 2.204.1 LTS and later, with an API token, behind a proxy, and over
    HTTPS with a certificate you have explicitly trusted.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Stagecraft"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowBuild"
                    factoryClass="dev.stagecraft.ui.BuildsToolWindowFactory"/>
        <projectConfigurable instance="dev.stagecraft.ui.settings.StagecraftConfigurable"
                             id="dev.stagecraft.settings"
                             displayName="Stagecraft"
                             parentId="tools"/>
        <!-- §7.2: Appearance | Notifications | Jenkins Builds. -->
        <notificationGroup id="Stagecraft builds"
                           displayName="Jenkins Builds"
                           displayType="BALLOON"/>
        <!-- §7.2: start the service at project open, so branch balloons do not need the window. -->
        <postStartupActivity implementation="dev.stagecraft.service.StagecraftStartup"/>
    </extensions>

    <actions>
        <action id="dev.stagecraft.lintJenkinsfile"
                class="dev.stagecraft.ui.LintAction"
                text="Validate Jenkinsfile with Stagecraft"
                description="Run the server's Jenkinsfile linter on this buffer, unsaved edits included">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
